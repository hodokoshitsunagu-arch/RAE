<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/rl_room_name"
    android:background="@color/color_s_00"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <View
            android:id="@+id/image_close"
            android:background="@drawable/icon_group_create_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_s_02"
            android:layout_gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_new_chatroom"
            android:layout_centerInParent="true"/>
        <TextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/group_item_confirm_text"
            android:gravity="center"
            android:id="@+id/tv_college"
            android:background="@drawable/c_vp_selector_bg_create_room_btn"
            android:paddingLeft="@dimen/dp_10"
            android:paddingTop="3dp"
            android:paddingRight="@dimen/dp_10"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="52dp"
            android:text="群主学院"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="@dimen/dp_10"/>
    </RelativeLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="44dp"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_room_name"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_s_02"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:text="选择一个派对类型"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_classify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:requiresFadingEdge="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="16dp"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_s_02"
                android:gravity="center_vertical"
                android:id="@+id/tv_play_type"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp"
                android:text="选择派对主题"/>
            <cn.soulapp.cpnt_voiceparty.widget.TagRecyclerView
                android:id="@+id/rv_room_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:requiresFadingEdge="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <LinearLayout
                android:background="@drawable/bg_s14_corner_8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <EditText
                    android:textSize="15sp"
                    android:textColor="@color/color_s_02"
                    android:textColorHint="@color/color_s_06"
                    android:gravity="center_vertical"
                    android:id="@+id/et_room_name"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:hint="@string/c_vp_create_chat_room_remainder_times"
                    android:singleLine="true"
                    android:maxLength="15"
                    android:layout_weight="1"
                    android:paddingStart="15dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_s_01"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/tv_random"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:drawablePadding="3dp"
                    android:drawableStart="@drawable/icon_room_random_new"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="15dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/vg_history_name"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="40dp">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_s_15"
                    android:id="@+id/tv_history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="历史群名"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/color_s03"
                    android:ellipsize="end"
                    android:id="@+id/tv_first_history_name"
                    android:background="@drawable/c_vp_s14_lt13"
                    android:paddingLeft="10dp"
                    android:paddingTop="3dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="9dp"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintLeft_toRightOf="@+id/tv_history_title"
                    app:layout_constraintRight_toLeftOf="@+id/tv_history_more"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="13dp"
                    android:textColor="@color/color_s_19"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_history_more"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="更多"
                    android:drawablePadding="2dp"
                    android:drawableEnd="@drawable/icon_message_more_topic"
                    android:paddingEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_s_02"
                android:gravity="center_vertical"
                android:id="@+id/tv_select_fm_code"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="4dp"
                android:text="选择房间FM号"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="horizontal"
                android:id="@+id/selectFmContainer"
                android:background="@drawable/bg_s14_corner_8"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/color_s_02"
                    android:id="@+id/lastFmCode"
                    android:background="@drawable/bg_s14_corner_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <cn.com.hjq.shape.view.ShapeTextView
                    android:textSize="12dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_bababa"
                    android:gravity="center_vertical"
                    android:id="@+id/selectFmCode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="更多FM号"
                    android:drawableRight="@drawable/c_vp_fm_arrow_right"
                    android:paddingEnd="10dp"
                    app:layout_constraintBottom_toBottomOf="@+id/lastFmCode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/lastFmCode"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/color_s_02"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="18dp"
                android:text="选择派对背景图"/>
            <FrameLayout
                android:layout_gravity="center_horizontal"
                android:id="@+id/fl_bg_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/groupContainer"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">
                <ImageView
                    android:id="@+id/img_join_status"
                    android:layout_width="45dp"
                    android:layout_height="26dp"
                    android:src="@drawable/c_ct_groupchat_icon_setting_switch_off"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintRight_toRightOf="parent"/>
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/color_s_02"
                    android:id="@+id/tv_party_show"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="允许所有souler加入该派对"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="@+id/img_join_status"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/img_join_status"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/color_s_06"
                    android:id="@+id/tv_join_promt"
                    android:paddingBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="6dp"
                    android:text="关闭时，派对入口仅本群成员及其关注者可见"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/img_join_status"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <TextView
        android:enabled="false"
        android:textSize="14sp"
        android:textColor="@color/group_item_confirm_text"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/tv_confirm"
        android:background="@drawable/c_vp_selector_bg_create_room_btn"
        android:paddingLeft="10dp"
        android:paddingTop="3dp"
        android:paddingRight="10dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="248dp"
        android:layout_height="40dp"
        android:layout_marginBottom="66dp"
        android:minWidth="52dp"
        android:text="创建派对"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="20dp"/>
</FrameLayout>
