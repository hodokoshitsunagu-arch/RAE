<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flAll"
    android:background="@color/color_s_00"
    android:paddingTop="18dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="20dp"
    android:paddingEnd="15dp">
    <TextView
        android:textSize="15sp"
        android:textColor="@color/color_s_02"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/c_vp_cm_setting_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/color_s_06"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/c_vp_cm_setting_desc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <cn.soulapp.android.view.SwitchButton
        android:id="@+id/swcAllowCMM"
        android:layout_width="45dp"
        android:layout_height="26dp"
        android:layout_marginTop="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:switchOffSrc="@drawable/ic_setting_switch_off"
        app:switchOnSrc="@drawable/ic_setting_switch_on"/>
</androidx.constraintlayout.widget.ConstraintLayout>
