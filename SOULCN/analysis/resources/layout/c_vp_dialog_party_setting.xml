<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/c_vp_13151a_corner_32"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTitle"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/c_vp_nav_icon_close_white"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/color_ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="派对设置"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/clTitle">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/llFeature"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/llFeatureEntrances"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:layout_marginBottom="12dp"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clCurrentMode"
                android:background="@drawable/c_vp_0affffff_corner_24"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp">
                <ImageView
                    android:id="@+id/ivPlayMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/c_vp_ktv_audio_record_play"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="15dp"
                    android:textStyle="bold"
                    android:textColor="@color/color_ffffff"
                    android:id="@+id/tvPlayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="当前玩法:KTV"
                    android:layout_marginStart="4dp"
                    app:layout_constraintStart_toEndOf="@+id/ivPlayMode"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="12dp"
                    android:textColor="@color/color_888888"
                    android:ellipsize="end"
                    android:id="@+id/tvPlayModeDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="玩法介绍玩法介绍玩法介绍"
                    android:maxLines="1"
                    app:layout_constraintEnd_toStartOf="@+id/llSwitchMode"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constraintStart_toEndOf="@+id/ivPlayMode"
                    app:layout_constraintStart_toStartOf="@+id/tvPlayName"
                    app:layout_constraintTop_toBottomOf="@+id/tvPlayName"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/llSwitchMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textSize="12dp"
                        android:textColor="@color/color_888888"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/tvSwitchModeAction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="切换"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/c_vp_setting_item_go"
                        android:scaleType="fitXY"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#99ffffff"
                android:id="@+id/tvSectionUserManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="用户管理"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llUserManageCard"
                android:background="@drawable/c_vp_0affffff_corner_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llUserManageItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#99ffffff"
                android:id="@+id/tvSectionRoomSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="房间设置"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llRoomSettingCard"
                android:background="@drawable/c_vp_0affffff_corner_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llRoomSettingItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="12dp"
                android:textColor="#99ffffff"
                android:id="@+id/tvSectionOtherSetting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="23dp"
                android:text="其他设置"
                android:layout_marginStart="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/llOtherSettingCard"
                android:background="@drawable/c_vp_0affffff_corner_24"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/llOtherSettingItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
