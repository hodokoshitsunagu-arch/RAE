<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/roomInfoContainer"
        android:background="@drawable/c_vp_33ffffff_lt08"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <cn.com.hjq.shape.view.ShapeEditText
            android:textSize="14dp"
            android:textColor="@color/white"
            android:textColorHint="@color/c_vp_alpha_white_70"
            android:gravity="center_vertical"
            android:id="@+id/roomNameEt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="输入派对名，AI帮你生成或润色"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:maxLength="15"
            android:paddingStart="8dp"
            android:paddingEnd="26dp"
            app:layout_constraintEnd_toStartOf="@+id/randomNameBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shape_radius="8dp"
            app:shape_solidColor="#33000000"/>
        <ImageView
            android:id="@+id/randomNameBtn"
            android:layout_width="55dp"
            android:layout_height="26dp"
            android:src="@drawable/c_vp_create_room_name_ai_change"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/roomNameEt"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/roomNameEt"
            app:layout_constraintTop_toTopOf="@+id/roomNameEt"/>
        <ImageView
            android:id="@+id/clearNameBtn"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/c_vp_room_title_close"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/roomNameEt"
            app:layout_constraintEnd_toEndOf="@+id/roomNameEt"
            app:layout_constraintTop_toTopOf="@+id/roomNameEt"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/color_s_01"
            android:gravity="center"
            android:id="@+id/warmContentTv"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="2dp"
            app:drawableStartCompat="@drawable/c_vp_room_warm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/roomNameEt"/>
        <View
            android:id="@+id/splitLine"
            android:background="#14ffffff"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/warmContentTv"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/topicRv"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toStartOf="@+id/moreTopicIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/splitLine"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/moreTopicIcon"
            android:background="@drawable/c_vp_1affffff_lt19"
            android:visibility="gone"
            android:layout_width="30dp"
            android:layout_height="22dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/splitLine">
            <View
                android:background="@drawable/c_vp_ffffff_oval"
                android:layout_width="2dp"
                android:layout_height="2dp"/>
            <View
                android:background="@drawable/c_vp_ffffff_oval"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginStart="3dp"/>
            <View
                android:background="@drawable/c_vp_ffffff_oval"
                android:layout_width="2dp"
                android:layout_height="2dp"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottomOptionRow"
        android:background="@drawable/c_vp_33ffffff_lt08"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/roomInfoContainer">
        <LinearLayout
            android:id="@+id/vgFmCodeView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <cn.soulapp.cpnt_voiceparty.createroom.ui.LeftTextRightIconCommonView
                android:id="@+id/fmCodeView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:id="@+id/horizontalSpilt1"
                android:background="#14ffffff"
                android:layout_width="0.5dp"
                android:layout_height="16dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <cn.soulapp.cpnt_voiceparty.createroom.ui.LeftTextRightIconCommonView
                android:id="@+id/partyTypeView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:gravity="end"
                android:id="@+id/horizontalSpilt2"
                android:background="#14ffffff"
                android:layout_width="0.5dp"
                android:layout_height="16dp"/>
        </LinearLayout>
        <cn.soulapp.cpnt_voiceparty.createroom.ui.LeftTextRightIconCommonView
            android:id="@+id/partyStateView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>
    <cn.com.hjq.shape.layout.ShapeConstraintLayout
        android:id="@+id/creatorHallEntry"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/bottomOptionRow"
        app:shape_angle="0"
        app:shape_endColor="#805e457e"
        app:shape_radius="12dp"
        app:shape_startColor="#1a5e457e"
        app:shape_strokeColor="#4dffffff"
        app:shape_strokeWidth="0.5dp">
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/creatorHallTitleTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="创作大厅"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toTopOf="@+id/creatorHallSubtitleTv"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="11dp"
            android:textColor="#ccffffff"
            android:ellipsize="end"
            android:id="@+id/creatorHallSubtitleTv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="超多派对模版，还可亲手打造你自己的挚友派对"
            android:singleLine="true"
            android:includeFontPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/creatorHallArrowIv"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/creatorHallTitleTv"/>
        <ImageView
            android:id="@+id/creatorHallArrowIv"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/arrow_right_white"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </cn.com.hjq.shape.layout.ShapeConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
